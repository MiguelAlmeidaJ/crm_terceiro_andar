{
  "name": "terceiro-andar-crm",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @crm/api --filter @crm/web dev",
    "build": "pnpm --filter @crm/api build && pnpm --filter @crm/web build",
    "db:generate": "pnpm --filter @crm/api prisma:generate",
    "db:push": "pnpm --filter @crm/api prisma:push",
    "db:seed": "pnpm --filter @crm/api prisma:seed",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "restart:pm2": "pm2 restart ecosystem.config.cjs --update-env",
    "stop:pm2": "pm2 stop ecosystem.config.cjs",
    "logs:pm2": "pm2 logs"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.9"
}
